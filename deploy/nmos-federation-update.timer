# Optional: run the update unit regularly, not only at boot.
# Enable with: sudo systemctl enable --now nmos-federation-update.timer

[Unit]
Description=Update NMOS Federation nightly

[Timer]
OnCalendar=*-*-* 04:00:00
# If the host was off at 04:00, catch up once it is back.
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
